# 个人私有数据文件（防敏感数据泄露）
resume_data*.json
*real*.json
my_resume*.json
*.local.json
*.secret.json

# 系统文件
.DS_Store
Thumbs.db
Desktop.ini

# 编辑器与IDE配置
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# 扩展打包与发行产物
dist/
build/
*.crx
*.pem
*.zip

# 依赖与日志
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
*.log
agent_debug.log
# 验证码接收服务的运行日志（可能含本机局域网 IP，禁止入仓）
tools/sms_server.log
tools/*.log

# 开源版不发布验证码接收服务，整个 tools/ 目录不入仓
tools/

# 临时文件
*.tmp
*.swp
*.bak
*.bak-*
